root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# PHP is tab-indented. This is a deliberate, documented departure from PSR-12 §2.4 —
# see docs/coding-style.md, Deviation 1. It is mirrored in .php-cs-fixer.dist.php's
# ->setIndent("\t"); php-cs-fixer does NOT read this file, so the two must be kept in step.
[*.php]
indent_style = tab
indent_size = 4

[*.js]
indent_style = tab
indent_size = 4

# css/luna.css is GENERATED by `make css` from the scss/ tree. Dart Sass emits
# two-space indentation and has no tab option, so this is a fact about the build,
# not a style choice. Edit scss/, never the compiled CSS.
[*.css]
indent_style = space
indent_size = 2

[*.{xsl,xml,html}]
indent_style = tab
indent_size = 2

[*.{ini,sql,txt}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
