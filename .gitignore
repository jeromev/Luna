# Database credentials — copy db.example.ini and fill in your values
luna/luna.domains/*/ini/db.ini

# Local environment overrides (SPARQL proxy credentials, etc.) — copy .env.example
.env

# Cache files (writable dir kept, contents ignored)
luna/luna.domains/*/cache/*
!luna/luna.domains/*/cache/.gitkeep

# Subversion metadata (old VCS artifacts)
**/.svn/

# macOS
.DS_Store
Thumbs.db

# Materialised triplestore dump (regenerate with `ontop materialize`)
semantic/ontop/dump.nt

# Sass build artifacts
.sass-cache/
*.css.map

# Render-diff baselines are COMMITTED, not ignored: CI compares against them, so a dependency
# bump or model change has to prove itself output-neutral against a fixed reference rather than
# against a capture from its own run. Re-capture with `make render-capture` when a diff is
# inspected and accepted. (See the header of test/render_diff.sh.)

# site-specific page-label catalogs (local gettext domain, not part of the engine).
# Per-domain: each luna.domains/<domain>/locale/<lang>/LC_MESSAGES/local.* is local data.
luna/luna.domains/*/locale/*/LC_MESSAGES/local.po
luna/luna.domains/*/locale/*/LC_MESSAGES/local.mo

# Internal working records (analysis reports, plans, session notes) — kept LOCAL and
# uncommitted on purpose. Not project documentation; not for the committed/public repo.
docs/internal/
