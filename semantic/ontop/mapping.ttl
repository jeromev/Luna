@prefix rr:     <http://www.w3.org/ns/r2rml#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix luna:   <https://jeromev.github.io/Luna/ontology#> .

# ---------------------------------------------------------------------------
# R2RML mapping: the luna_* relational schema (MySQL) projected to schema.org /
# FOAF, using the SAME http://localhost:8080/id/{lid} URIs as the JSON-LD
# projection in lunaModel::to_jsonld() (see docs/linked-data.md). Because the
# URIs match, the virtual SPARQL graph and the JSON-LD describe the very same
# resources.
#
# luna_types ids are hard-coded in the WHERE clauses (user=1, level=3, text=4,
# page=5; see the luna_types seed in luna/luna.sql/luna.mysql.sql) to keep the
# SQL simple for Ontop's parser. This same mapping materialises into the Phase B
# triplestore unchanged — it is the bridge between A and B.
# ---------------------------------------------------------------------------

# Pages -> schema:WebPage
<#PageMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT n.nid AS nid, n.lid AS lid, n.is_active AS active, pn.lid AS parent_lid
      FROM luna_nodes n
      LEFT JOIN luna_nodes pn ON pn.nid = n.parent_nid
      WHERE n.tid = 5
  """ ] ;
  rr:subjectMap [
      rr:template "http://localhost:8080/id/{lid}" ;
      rr:class schema:WebPage
  ] ;
  # The slug is the routing key, so it is luna:lid — not schema:name, which is the display
  # name. Keeping these apart is roadmap decision #9; this mapping must move with the PHP
  # write-through in lunaGraph::rdf_sync_node() or the two SQL-to-RDF projections diverge.
  rr:predicateObjectMap [
      rr:predicate luna:lid ;
      rr:objectMap [ rr:column "lid" ]
  ] ;
  rr:predicateObjectMap [
      rr:predicate schema:identifier ;
      rr:objectMap [ rr:column "nid" ]
  ] ;
  rr:predicateObjectMap [
      rr:predicate luna:isActive ;
      rr:objectMap [ rr:column "active" ]
  ] ;
  rr:predicateObjectMap [
      rr:predicate schema:isPartOf ;
      rr:objectMap [ rr:template "http://localhost:8080/id/{parent_lid}" ]
  ] .

# Text blocks -> schema:Article, attached to their page
<#TextMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT n.nid AS nid, n.lid AS lid, t.title AS title, t.content AS body,
             t.lang AS lang, p.lid AS page_lid
      FROM luna_nodes n
      JOIN luna_texts t     ON t.nid = n.nid
      JOIN luna_nodes_map m ON m.nid1 = n.nid
      JOIN luna_nodes p     ON p.nid = m.nid2 AND p.tid = 5
      WHERE n.tid = 4
  """ ] ;
  rr:subjectMap [
      rr:template "http://localhost:8080/id/{lid}" ;
      rr:class schema:Article
  ] ;
  rr:predicateObjectMap [ rr:predicate schema:identifier ; rr:objectMap [ rr:column "nid" ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:headline ;    rr:objectMap [ rr:column "title" ] ] ;
  # luna:content is the Markdown source (the authored truth). schema:articleBody is meant
  # to be the plain-text projection; the app strips the rendered Markdown to text, but plain
  # SQL cannot, so this virtual view exposes the Markdown source verbatim as a close proxy.
  rr:predicateObjectMap [ rr:predicate schema:articleBody ; rr:objectMap [ rr:column "body" ] ] ;
  rr:predicateObjectMap [ rr:predicate luna:content ;       rr:objectMap [ rr:column "body" ] ] ;
  rr:predicateObjectMap [ rr:predicate schema:inLanguage ;  rr:objectMap [ rr:column "lang" ] ] ;
  rr:predicateObjectMap [
      rr:predicate schema:isPartOf ;
      rr:objectMap [ rr:template "http://localhost:8080/id/{page_lid}" ]
  ] .

# Reciprocal: page schema:hasPart text
<#PageHasPartMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT p.lid AS page_lid, n.lid AS text_lid
      FROM luna_nodes n
      JOIN luna_nodes_map m ON m.nid1 = n.nid
      JOIN luna_nodes p     ON p.nid = m.nid2 AND p.tid = 5
      WHERE n.tid = 4
  """ ] ;
  rr:subjectMap [ rr:template "http://localhost:8080/id/{page_lid}" ] ;
  rr:predicateObjectMap [
      rr:predicate schema:hasPart ;
      rr:objectMap [ rr:template "http://localhost:8080/id/{text_lid}" ]
  ] .

# Users -> foaf:Person
<#UserMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT n.lid AS email, u.firstname AS fn, u.lastname AS ln
      FROM luna_nodes n
      JOIN luna_users u ON u.nid = n.nid
      WHERE n.tid = 1
  """ ] ;
  rr:subjectMap [
      rr:template "http://localhost:8080/id/{email}" ;
      rr:class foaf:Person
  ] ;
  rr:predicateObjectMap [
      rr:predicate foaf:name ;
      rr:objectMap [ rr:template "{fn} {ln}" ; rr:termType rr:Literal ]
  ] .

# Access levels (needed to reproduce the routing/ACL read path in SPARQL)
<#LevelMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT n.nid AS nid, n.lid AS lid, n.is_active AS active
      FROM luna_nodes n WHERE n.tid = 3
  """ ] ;
  rr:subjectMap [ rr:template "http://localhost:8080/id/{lid}" ] ;
  rr:predicateObjectMap [ rr:predicate schema:identifier ; rr:objectMap [ rr:column "nid" ] ] ;
  rr:predicateObjectMap [ rr:predicate luna:lid ;          rr:objectMap [ rr:column "lid" ] ] ;
  rr:predicateObjectMap [ rr:predicate luna:isActive ;     rr:objectMap [ rr:column "active" ] ] .

# Page -> required access level (luna_nodes_map edge)
<#PageLevelMap>
  rr:logicalTable [ rr:sqlQuery """
      SELECT p.lid AS page_lid, l.lid AS level_lid
      FROM luna_nodes_map m
      JOIN luna_nodes p ON p.nid = m.nid1 AND p.tid = 5
      JOIN luna_nodes l ON l.nid = m.nid2 AND l.tid = 3
  """ ] ;
  rr:subjectMap [ rr:template "http://localhost:8080/id/{page_lid}" ] ;
  rr:predicateObjectMap [
      rr:predicate luna:level ;
      rr:objectMap [ rr:template "http://localhost:8080/id/{level_lid}" ]
  ] .
